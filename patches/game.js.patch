+  // Open a real, wallet-backed repair transaction. Call from the W hotkey
+  // while paused or driving slowly; payment is deducted only after consent.
+  openWorkshopService() {
+    if (!this.vehicleLifecycle || !this.playerVehicleId) {
+      this.ui.toast('Vehicle service is unavailable in this build.');
+      return { ok: false, reason: 'lifecycle_unavailable' };
+    }
+
+    const workshops = this.workshopRecovery.listWorkshops({ openOnly: true });
+    if (!workshops.length) {
+      this.ui.toast('No mechanic is open right now.');
+      return { ok: false, reason: 'no_open_workshops' };
+    }
+
+    const menu = workshops.map((workshop, index) =>
+      `${index + 1}. ${workshop.name} (${workshop.district})`
+    ).join('\n');
+    const answer = window.prompt(`KANO LIFE · CHOOSE A MECHANIC\n${menu}\nEnter workshop number:` , '1');
+    if (answer === null) return { ok: false, reason: 'cancelled' };
+    const selectedIndex = Number.parseInt(answer, 10) - 1;
+    const workshop = workshops[selectedIndex];
+    if (!workshop) {
+      this.ui.toast('Invalid mechanic selection.');
+      return { ok: false, reason: 'invalid_workshop' };
+    }
+
+    let quote;
+    try {
+      quote = this.vehicleLifecycle.calculateRepair(this.playerVehicleId, {
+        workshop: true,
+        includeService: true,
+      });
+    } catch (error) {
+      console.warn('[Kano Life] workshop quote failed:', error);
+      this.ui.toast('Unable to prepare a repair quote.');
+      return { ok: false, reason: 'quote_failed' };
+    }
+
+    if (!quote.items.length || quote.total <= 0) {
+      this.ui.toast('Your keke is in good condition; no workshop service is needed.');
+      return { ok: true, noRepairNeeded: true, quote };
+    }
+
+    const itemLines = quote.items.map(item =>
+      `• ${item.part.replaceAll('_', ' ')}: ₦${Number(item.cost).toLocaleString()}`
+    ).join('\n');
+    const total = Math.floor(quote.total);
+    const approved = window.confirm(
+      `${workshop.name}\n\n${itemLines}\n\nTotal: ₦${total.toLocaleString()}\nWallet: ₦${Math.floor(save.money || 0).toLocaleString()}\n\nPay and repair the keke?`
+    );
+    if (!approved) return { ok: false, reason: 'declined', quote };
+    if ((Number(save.money) || 0) < total) {
+      this.ui.toast(`Not enough money. You need ₦${(total - (Number(save.money) || 0)).toLocaleString()} more.`);
+      return { ok: false, reason: 'insufficient_funds', quote };
+    }
+
+    // The local save is the game's existing wallet. Persist the deduction
+    // before applying repair, then use the lifecycle's payment-confirmed API.
+    save.money = Math.max(0, Math.floor((Number(save.money) || 0) - total));
+    persist();
